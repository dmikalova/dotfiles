#!/bin/zsh

# archives: ouch detects the format from the file name
alias compress='ouch compress'
alias expand='ouch decompress'

# aws
alias awsume='source awsume'

# brew
alias bu='brew update && brew upgrade && brew cleanup && antidote update'

# builtins
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias caff='caffeinate -ud'
alias cat='bat --paging=never'
alias cl='pbcopy'
alias cld='printf "%s" $(pwd) | cl'
alias cp='cp -ir'
alias cdg='cd $(git rev-parse --show-toplevel)'
alias diff='colordiff'
alias g='rg --ignore-case'
alias ll='eza -l --git --icons'
alias ls='eza --group-directories-first'
alias lt='eza --tree --level=2'
alias mv='mv -i'
alias reboot='sudo reboot'

# claude - noglob so `?` and `*` in the question aren't globbed
alias '??'='noglob ask'
alias explain='noglob explain'

# chezmoi
alias cza='chezmoi apply && exec zsh'
alias czr='chezmoi re-add'
alias czs='chezmoi status'

# git
alias gcpa='git-commit-push-all'
alias gs='git status'
alias ge='git commit --amend --no-edit && git push -f'

# npm
alias npmi='npm install'

# terraform
alias tf='terraform'
alias tfa="tf apply 'terraform.plan'"
alias tfi='tf init'
alias tfip='tfi && tfp'
alias tfla='tflint-all'
alias tfp="tf plan -out 'terraform.plan'"

# utilities
alias file-count='echo $PWD; for t in files links directories; do echo `find . -type ${t:0:1} | wc -l` $t; done 2> /dev/null'
alias rm-empty-subdirs='find . -type d -empty -print -delete'
alias serve-dir='python3 -m http.server 54003'

# vscode
alias cg='code $(git rev-parse --show-toplevel)'
