# run commands on multiple piped lines
# ... | each command1 command2 "command3 has spaces"
each() {
    while read line; do
        for f in "$@"; do
            "$f" "$line"
        done
    done
}

# Determine size of a file or total size of a directory
fs() {
    if du -b /dev/null >/dev/null 2>&1; then
        local arg=-sbh
    else
        local arg=-sh
    fi
    # shellcheck disable=SC2199
    if [[ -n "$@" ]]; then
        du $arg -- "$@"
    else
        du $arg -- .[^.]* *
    fi
}

# Make PR for github
ghpr() {
    gh pr create --base main --head $(git branch --show-current) --title \"${1}\" --assignee @me
}

git-tag() {
    if [[ -z "$1" ]]; then
        echo "Usage: git-tag <env>" >&2
        return 1
    fi
    local env="$1"
    git commit -a -n
    git tag -d "$env"
    git push origin ":refs/tags/$env" --no-verify
    git tag "$env" -m "$env"
    git push --no-verify
    git push origin "$env" --no-verify
}

# colorize man pages
man() {
    env \
        LESS_TERMCAP_mb="$(printf '\e[1;31m')" \
        LESS_TERMCAP_md="$(printf '\e[1;31m')" \
        LESS_TERMCAP_me="$(printf '\e[0m')" \
        LESS_TERMCAP_se="$(printf '\e[0m')" \
        LESS_TERMCAP_so="$(printf '\e[1;44;33m')" \
        LESS_TERMCAP_ue="$(printf '\e[0m')" \
        LESS_TERMCAP_us="$(printf '\e[1;32m')" \
        man "$@"
}

# Create a new directory and enter it
mkd() {
    mkdir -p "$@"
    cd "$@" || exit
}

# pulumi init project
# TODO: fill in the real AWS profile per stage and the Pulumi Cloud org name
pulumi_init() { (
    set -e

    local -A stage_profiles=(
        [dev]="TODO-dev-profile"
        [stg]="TODO-stg-profile"
        [prd]="TODO-prd-profile"
    )
    local pulumi_org="TODO-pulumi-org"

    if [ ! -f Pulumi.yaml ]; then
        echo "Pulumi.yaml does not exist. Aborting initialization."
        exit 1
    fi

    if [ ! -f .tool-versions ]; then
        echo "nodejs 20.18.3" >".tool-versions"
    fi

    pulumi install

    for stage in dev stg prd; do
        local profile="${stage_profiles[$stage]}"

        if ! aws sts get-caller-identity --profile "$profile" >/dev/null 2>&1; then
            aws sso login --profile "$profile"
        fi
        awsume "$profile"

        if ! pulumi stack select "$stage"; then
            pulumi stack init "${pulumi_org}/${stage}"
        fi
        pulumi stack select "$stage"
        pulumi up
    done

    NAME=$(yq '.name' ./Pulumi.yaml)
    for stage in prd stg dev; do
        open "https://app.pulumi.com/${pulumi_org}/${NAME}/${stage}/settings/access"
    done

    TEAM=$(pulumi config get --path 'aws:defaultTags.tags.team')
    echo "Update access for each stack:"
    echo "  eng-cloud-reliability: admin"
    echo "  $TEAM: write"
); }
