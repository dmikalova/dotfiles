# Source a tool's generated init script from the cache, regenerating it when
# the tool's binary is newer (e.g. after brew upgrade). Saves a subprocess per
# tool on every shell start.
# Usage: _cached_init <binary> <command that prints the init script>
_cached_init() {
    local bin="${commands[$1]}" cache="${ZSH_CACHE_DIR}/init-${1}.zsh"
    [[ -s $cache && $cache -nt $bin ]] || eval "$2" >|"$cache"
    source "$cache"
}

# run commands on multiple piped lines
# ... | each command1 command2 "command3 has spaces"
each() {
    while read line; do
        for f in "$@"; do
            "$f" "$line"
        done
    done
}

# AWS SSO login if needed, then select the profile (default sb-ro).
# A function, not a script: the profile must be set in the current shell.
aws-auth() {
    local role="${1:-sb-ro}"

    # Check if SSO session is valid
    if ! aws sts get-caller-identity --profile "$role" &>/dev/null; then
        echo "AWS SSO not logged in. Logging in..."
        if ! aws sso login --profile "$role"; then
            echo "AWS SSO login failed"
            return 1
        fi
    fi

    unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN
    unset AWS_CREDENTIAL_EXPIRATION AWSUME_PROFILE AWSUME_EXPIRATION AWSUME_COMMAND
    unset AWS_REGION AWS_DEFAULT_REGION
    export AWS_PROFILE="$role" AWS_DEFAULT_PROFILE="$role"
    aws sts get-caller-identity >/dev/null
}

# Keep the machine awake until a wall-clock time. A time already passed today
# means the same time tomorrow. Runs in the foreground; Ctrl-C ends it early.
# Usage: caff-until HH:MM
caff-until() {
    if [[ ! "$1" =~ '^[0-9]{2}:[0-9]{2}$' ]]; then
        echo "Usage: caff-until HH:MM" >&2
        return 1
    fi
    zmodload -F zsh/datetime b:strftime p:EPOCHSECONDS

    local now=$EPOCHSECONDS end
    end=$(date -j -f '%Y-%m-%d %H:%M' "$(strftime '%Y-%m-%d' $now) $1" '+%s') || return 1
    ((end <= now)) && ((end += 86400))

    echo "Awake until $(strftime '%a %H:%M' $end) ($(((end - now) / 60))m)"
    caffeinate -ud -t $((end - now))
}

caff-work() { caff-until 18:00 }
caff-home() { caff-until 01:00 }

# rm: move to the macOS Trash instead of deleting. rm-style flags (-r, -f, ...)
# are dropped - /usr/bin/trash rejects them - so `rm -rf dir` still works.
rm() {
    local -a files=("${(@)@:#-*}")
    /usr/bin/trash "${files[@]}"
}

# Determine size of a file or total size of a directory
fs() {
    if du -b /dev/null >/dev/null 2>&1; then
        local arg=-sbh
    else
        local arg=-sh
    fi
    # shellcheck disable=SC2199
    if [[ -n "$@" ]]; then
        du $arg -- "$@"
    else
        du $arg -- .[^.]* *
    fi
}

# Make PR for github
ghpr() {
    gh pr create --base main --head $(git branch --show-current) --title \"${1}\" --assignee @me
}

git-tag() {
    if [[ -z "$1" ]]; then
        echo "Usage: git-tag <env>" >&2
        return 1
    fi
    local env="$1"
    git commit -a -n
    git tag -d "$env"
    git push origin ":refs/tags/$env" --no-verify
    git tag "$env" -m "$env"
    git push --no-verify
    git push origin "$env" --no-verify
}

# Bring the current branch up to date, keeping history linear and the next push
# a fast-forward. Absorbs rewrites made by the Update with rebase button.
git-update() {
    git rev-parse --git-dir >/dev/null 2>&1 || return 1

    local branch
    branch=$(git branch --show-current) || return 1
    if [[ -z "$branch" ]]; then
        echo "git-update: detached HEAD" >&2
        return 1
    fi

    local remote
    remote=$(git config "branch.${branch}.remote") || remote=origin

    # Read the old remote tip before fetching so a rewrite is detectable.
    local old new
    old=$(git rev-parse --verify --quiet "refs/remotes/${remote}/${branch}")
    git fetch --prune "$remote" || return 1
    new=$(git rev-parse --verify --quiet "refs/remotes/${remote}/${branch}")

    if [[ -n "$new" && "$new" != "$old" ]]; then
        if [[ -z "$old" ]] || git merge-base --is-ancestor "$old" "$new"; then
            git rebase "$new" || return 1
        else
            # The remote branch was rewritten, so replay only the commits that
            # the old remote tip did not already have.
            git rebase --onto "$new" "$old" "$branch" || return 1
        fi
    fi

    # origin/HEAD is absent in some clones, so refresh it before reading.
    git remote set-head "$remote" --auto >/dev/null 2>&1
    local default
    default=$(git symbolic-ref --short "refs/remotes/${remote}/HEAD" 2>/dev/null)
    : "${default:=${remote}/main}"

    [[ "$default" == "${remote}/${branch}" ]] && return 0
    git merge-base --is-ancestor "$default" HEAD && return 0

    # Rebasing a published branch onto the default branch would rewrite commits
    # the remote already has, which only a force push could deliver.
    if [[ -n "$new" ]]; then
        echo "git-update: ${branch} is behind ${default}." >&2
        echo "git-update: use Update with rebase on the pull request, then run gu again." >&2
        return 1
    fi

    git rebase "$default"
}

# cd into the first dmikalova repo with uncommitted changes
gh-dmikalova-uncommitted() {
    local base_dir="${HOME}/Code/github.com/dmikalova"
    for dir in "$base_dir"/*(N/); do
        if git -C "$dir" status --porcelain 2>/dev/null | grep -q .; then
            cd "$dir"
            echo "Uncommitted changes in: ${dir:t}"
            return 0
        fi
    done
    echo "No uncommitted changes found."
}

# cd into the next cddc39 or dmikalova repo with unpushed commits, or, when
# none has any, the next with uncommitted changes. Each search starts after the
# current repo and wraps around, so repeated calls walk through them all.
git-next-push() {
    local code="${HOME}/Code/github.com"
    local -a repos=("$code"/{cddc39,dmikalova}/*/.git(N/:h))
    local -i n=${#repos} start=${repos[(ie)$(git rev-parse --show-toplevel 2>/dev/null)]}
    (( start > n )) && start=0
    local -i i count
    local dir
    for (( i = 1; i <= n; i++ )); do
        dir=${repos[(start - 1 + i) % n + 1]}
        count=$(git -C "$dir" rev-list --count HEAD --not --remotes=origin 2>/dev/null)
        if (( count > 0 )); then
            cd "$dir"
            echo "${count} unpushed commit(s) in: ${dir#$code/}"
            return 0
        fi
    done
    for (( i = 1; i <= n; i++ )); do
        dir=${repos[(start - 1 + i) % n + 1]}
        count=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l)
        if (( count > 0 )); then
            cd "$dir"
            echo "${count} uncommitted change(s) in: ${dir#$code/}"
            return 0
        fi
    done
    echo "No unpushed commits or uncommitted changes found."
}

# Open the files in a directory (default: current) in VS Code, at most 25.
# Subdirectories and hidden files are skipped.
code-files() {
    local dir="${1:-.}" max=25
    local -a files=("$dir"/*(N.n))
    if (( ! ${#files} )); then
        echo "No files in: $dir" >&2
        return 1
    fi
    (( ${#files} > max )) && echo "Opening the first ${max} of ${#files} files in: $dir" >&2
    code "${files[@]:0:$max}"
}

# Create a new directory and enter it
mkd() {
    mkdir -p "$@"
    cd "$@" || return
}

