# Source a tool's generated init script from the cache, regenerating it when
# the tool's binary is newer (e.g. after brew upgrade). Saves a subprocess per
# tool on every shell start.
# Usage: _cached_init <binary> <command that prints the init script>
_cached_init() {
    local bin="${commands[$1]}" cache="${ZSH_CACHE_DIR}/init-${1}.zsh"
    [[ -s $cache && $cache -nt $bin ]] || eval "$2" >|"$cache"
    source "$cache"
}

# run commands on multiple piped lines
# ... | each command1 command2 "command3 has spaces"
each() {
    while read line; do
        for f in "$@"; do
            "$f" "$line"
        done
    done
}

# AWS SSO login if needed, then assume the role (default sb-ro). A function,
# not a script: awsume sets credentials in the current shell.
aws-auth() {
    local role="${1:-sb-ro}"

    # Check if SSO session is valid
    if ! aws sts get-caller-identity --profile "$role" &>/dev/null; then
        echo "AWS SSO not logged in. Logging in..."
        if ! aws sso login --profile "$role"; then
            echo "AWS SSO login failed"
            return 1
        fi
    fi

    awsume "$role"
}
# rm: move to the macOS Trash instead of deleting. rm-style flags (-r, -f, ...)
# are dropped - /usr/bin/trash rejects them - so `rm -rf dir` still works.
rm() {
    local -a files=("${(@)@:#-*}")
    /usr/bin/trash "${files[@]}"
}

# Determine size of a file or total size of a directory
fs() {
    if du -b /dev/null >/dev/null 2>&1; then
        local arg=-sbh
    else
        local arg=-sh
    fi
    # shellcheck disable=SC2199
    if [[ -n "$@" ]]; then
        du $arg -- "$@"
    else
        du $arg -- .[^.]* *
    fi
}

# Make PR for github
ghpr() {
    gh pr create --base main --head $(git branch --show-current) --title \"${1}\" --assignee @me
}

git-tag() {
    if [[ -z "$1" ]]; then
        echo "Usage: git-tag <env>" >&2
        return 1
    fi
    local env="$1"
    git commit -a -n
    git tag -d "$env"
    git push origin ":refs/tags/$env" --no-verify
    git tag "$env" -m "$env"
    git push --no-verify
    git push origin "$env" --no-verify
}

# cd into the first dmikalova repo with uncommitted changes
gh-dmikalova-uncommitted() {
    local base_dir="${HOME}/Code/github.com/dmikalova"
    for dir in "$base_dir"/*(N/); do
        if git -C "$dir" status --porcelain 2>/dev/null | grep -q .; then
            cd "$dir"
            echo "Uncommitted changes in: ${dir:t}"
            return 0
        fi
    done
    echo "No uncommitted changes found."
}

# cd into the next cddc39 or dmikalova repo with unpushed commits. Starts after
# the current repo and wraps around, so repeated calls walk through them all.
git-next-push() {
    local code="${HOME}/Code/github.com"
    local -a repos=("$code"/{cddc39,dmikalova}/*/.git(N/:h))
    local -i n=${#repos} start=${repos[(ie)$(git rev-parse --show-toplevel 2>/dev/null)]}
    (( start > n )) && start=0
    local -i i count
    local dir
    for (( i = 1; i <= n; i++ )); do
        dir=${repos[(start - 1 + i) % n + 1]}
        count=$(git -C "$dir" rev-list --count HEAD --not --remotes=origin 2>/dev/null)
        if (( count > 0 )); then
            cd "$dir"
            echo "${count} unpushed commit(s) in: ${dir#$code/}"
            return 0
        fi
    done
    echo "No unpushed commits found."
}

# Create a new directory and enter it
mkd() {
    mkdir -p "$@"
    cd "$@" || return
}

# pulumi init project
# TODO: fill in the real AWS profile per stage and the Pulumi Cloud org name
pulumi_init() { (
    set -e

    local -A stage_profiles=(
        [dev]="TODO-dev-profile"
        [stg]="TODO-stg-profile"
        [prd]="TODO-prd-profile"
    )
    local pulumi_org="TODO-pulumi-org"

    if [ ! -f Pulumi.yaml ]; then
        echo "Pulumi.yaml does not exist. Aborting initialization."
        exit 1
    fi

    if [ ! -f .tool-versions ]; then
        echo "nodejs 20.18.3" >".tool-versions"
    fi

    pulumi install

    for stage in dev stg prd; do
        local profile="${stage_profiles[$stage]}"

        if ! aws sts get-caller-identity --profile "$profile" >/dev/null 2>&1; then
            aws sso login --profile "$profile"
        fi
        awsume "$profile"

        if ! pulumi stack select "$stage"; then
            pulumi stack init "${pulumi_org}/${stage}"
        fi
        pulumi stack select "$stage"
        pulumi up
    done

    NAME=$(yq '.name' ./Pulumi.yaml)
    for stage in prd stg dev; do
        open "https://app.pulumi.com/${pulumi_org}/${NAME}/${stage}/settings/access"
    done

    TEAM=$(pulumi config get --path 'aws:defaultTags.tags.team')
    echo "Update access for each stack:"
    echo "  eng-cloud-reliability: admin"
    echo "  $TEAM: write"
); }
