append_path() {
    local DIR="$1"

    if [ ! -d "${DIR}" ]; then
        return
    fi

    PATH="${PATH//":${DIR}"/}"
    export PATH="${PATH:+${PATH}:}${DIR}"
}

# bin
export BIN_DIR="${HOME}/.local/bin"
append_path "${BIN_DIR}"

# brew
eval "$(/opt/homebrew/bin/brew shellenv)"

# git
export GIT_CONFIG="${HOME}/.config/git/config"

# go
append_path "$(go env GOPATH)/bin"

# gpg
export GPG_TTY=$(tty)

# locale
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# nvm
export NVM_DIR="${HOME}/.nvm"
# export NPM_CONFIG_USERCONFIG="${HOME}/.config/npm/npmrc"

# sops
export SOPS_AGE_RECIPIENTS="age1ahclcge5vrwwsc6nsud3t4h2mpx4e8ad3ta6aaxu4k87yeqc6vaqdxtpkx"
export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/key.txt"

# terraform
# export TF_CLI_CONFIG_FILE="${HOME}/.config/terraform/terraformrc"

# vim
export EDITOR="vim"

# secrets
{{ if eq .chezmoi.os "darwin" -}}
# read directly from macOS Keychain (dotfiles-secrets), never written to disk
# `security -w` prints hex only when the value has non-ASCII bytes, plain
# text otherwise -- detect which we got before decoding.
SECRETS_RAW=$(security find-generic-password -a "$USER" -s "dotfiles-secrets" -w 2>/dev/null)
case "${SECRETS_RAW}" in
    '') SECRETS_JSON='' ;;
    *[!0-9a-fA-F]*) SECRETS_JSON="${SECRETS_RAW}" ;;
    *) SECRETS_JSON=$(echo "${SECRETS_RAW}" | xxd -r -p) ;;
esac
if [ -n "${SECRETS_JSON}" ]; then
    eval "$(echo "${SECRETS_JSON}" | jq -r 'to_entries[] | "export " + .key + "=" + (.value | @sh)')"
fi
unset SECRETS_RAW SECRETS_JSON
{{ else -}}
# generated by chezmoi from SOPS
SECRETS_FILE="${HOME}/.config/secrets/env.sh"
if [ -f "${SECRETS_FILE}" ]; then
    source "${SECRETS_FILE}"
fi
{{ end -}}

# zsh
export ZSH_COMPLETIONS_DIR="${DIR}/completions"
export ZSH_CACHE_DIR="${DIR}/cache"
export _Z_DATA="${ZSH_CACHE_DIR}/z_data"
export FPATH="$FPATH:${ZSH_COMPLETIONS_DIR}"

unfunction append_path
