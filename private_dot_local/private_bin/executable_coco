#!/bin/zsh
# Semantic commit and push. Stages all changes, uses Claude to write a
# semantic commit message, then pushes. Repos owned by dmikalova may commit
# and push directly to the default branch; other repos may not.

set -euo pipefail
if [ "${DEBUG:=}" = true ]; then set -x; fi

# Keep the AI output from the first conventional-commit title on. Drops any
# preface and code fences, and markdown (heading, bullet, bold, backticks)
# around the title.
_from_first_cc_line() {
	printf '%s\n' "$1" | awk '
		BEGIN { found = 0 }
		/^[ \t]*```/ { next }
		!found {
			line = $0
			sub(/^[ \t]*(#+[ \t]*|[-*][ \t]+)?/, "", line)
			gsub(/\*\*|__|`/, "", line)
			if (line ~ /^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]*\))?!?:/) {
				found = 1
				print line
			}
			next
		}
		{ print }
	'
}

current_branch=$(git branch --show-current)
default_branch=$(git remote show origin 2>/dev/null | sed -n 's/.*HEAD branch: //p')
default_branch="${default_branch:-main}"

origin_url=$(git remote get-url origin 2>/dev/null || true)
owner=$(printf '%s' "$origin_url" | sed -E 's#(git@github\.com:|https://github\.com/)([^/]+)/.*#\2#')

if [[ "$current_branch" == "$default_branch" && "$owner" != "dmikalova" ]]; then
	echo "Cannot commit from the default branch ($current_branch)." >&2
	exit 1
fi

# With a clean tree, push any commits that haven't reached origin yet
if [[ -z "$(git status --porcelain 2>/dev/null)" ]]; then
	unpushed=$(git rev-list --count HEAD --not --remotes=origin)
	if [[ "$unpushed" -eq 0 ]]; then
		echo "Nothing to commit or push - working tree is clean." >&2
		exit 1
	fi
	echo "Working tree is clean. Pushing $unpushed unpushed commit(s)..."
	git push
	exit 0
fi

# Stage all changes
echo "Staging all changes..."
git add -A

# Run pre-commit hooks before spending time on AI
echo "Running pre-commit hooks..."
git hook run --ignore-missing pre-commit

# Generate commit message via AI
echo "Generating commit message..."
raw=$(git diff --cached | claude-bare \
	"You write git commit messages. Reply with the commit message only, as plain text: no preface, no markdown, no code fences." \
	"Write a commit message in Conventional Commits format for the diff on stdin: a subject line of at most 72 characters starting with a type such as feat, fix, docs, refactor or chore, then optionally a blank line and a body.")
if [[ -z "$raw" ]]; then
	echo "Failed to generate commit message." >&2
	exit 1
fi

msg="$(_from_first_cc_line "$raw")"
if [[ -z "$msg" ]]; then
	printf 'AI output missing a conventional commit title:\n%s\n' "$raw" >&2
	exit 1
fi

# Show and confirm
echo "\nCommit message:\n$msg\n"

# Commit (hooks already passed)
git commit -n -m "$msg"

# Push
echo "Pushing..."
git push
