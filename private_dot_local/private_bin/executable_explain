#!/bin/sh
# Ask Claude to explain a shell command.
# Usage: explain tar -xzvf archive.tar.gz

set -eu

if [ $# -eq 0 ]; then
	echo "Usage: explain <command>" >&2
	exit 1
fi

claude-bare "You explain shell commands. Be concise, no preamble." \
	"Explain this shell command - what it does and what each part means: $*"
