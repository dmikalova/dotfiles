#!/bin/sh
# Ask Claude for the shell command(s) to do something. Aliased to `??`.
# Usage: ?? find files over 100MB in this repo

set -eu

if [ $# -eq 0 ]; then
	echo "Usage: ?? <what you want to do>" >&2
	exit 1
fi

claude-bare "You answer shell questions for macOS zsh. Be concise, no preamble." \
	"Give the macOS zsh command(s) to do the following, each with a one-line explanation: $*"
