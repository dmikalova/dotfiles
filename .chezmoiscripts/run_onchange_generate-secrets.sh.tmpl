#!/bin/sh
# Ensure a secrets source exists. This runs during chezmoi apply, NOT on
# every shell startup. Secrets themselves are read live at shell startup
# (see exports.zsh.tmpl) -- this script never writes them to disk.
set -eu

{{ if eq .chezmoi.os "darwin" -}}
# macOS: secrets live in a single Keychain JSON entry, managed with the
# `secrets` TUI (tools/secrets) -- list/add/edit/rename/remove.
# Also visible (but not safely hand-editable; see the TUI's note on hex
# encoding) in Keychain Access.app (search "dotfiles-secrets").
if ! security find-generic-password -a "$USER" -s "dotfiles-secrets" >/dev/null 2>&1; then
    echo "warning: no dotfiles-secrets entry found in Keychain, creating a placeholder (edit it with the security/Keychain Access commands above)" >&2
    security add-generic-password -a "$USER" -s "dotfiles-secrets" \
        -w '{"EXAMPLE":"example"}' -U
fi

# Remove any stale plaintext secrets file left over from the old file-based approach.
rm -f "${HOME}/.config/secrets/env.sh"
{{ else -}}
# Linux: decrypt SOPS-encrypted env file to a local, mode-600 file.
SECRETS_DIR="${HOME}/.config/secrets"
SECRETS_FILE="${SECRETS_DIR}/env.sh"
SOPS_SOURCE="${SECRETS_DIR}/env.sops.sh"
mkdir -p "${SECRETS_DIR}"
chmod 700 "${SECRETS_DIR}"

if [ ! -f "${SOPS_SOURCE}" ]; then
    echo "warning: ${SOPS_SOURCE} not found, skipping secrets generation" >&2
    : > "${SECRETS_FILE}"
else
    echo "# Generated by chezmoi - do not edit" > "${SECRETS_FILE}"
    echo "# Source: SOPS (env.sops.sh)" >> "${SECRETS_FILE}"
    sops -d "${SOPS_SOURCE}" >> "${SECRETS_FILE}"
fi
chmod 600 "${SECRETS_FILE}"
{{ end -}}
